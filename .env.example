# Settings for the app. Use with: docker run --env-file .env ...  or export them in your shell.
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
LEADS_PATH=data/Nova_Digital_Leads.xlsx
PDF_PATH=data/Nova_Digital_Sales_Playbook.pdf
# 1 = run the web app without downloading any model (for UI work and tests)
MOCK_LLM=0
SESSION_TTL_MINUTES=120
MAX_SESSIONS=500
MAX_MESSAGE_CHARS=1000
