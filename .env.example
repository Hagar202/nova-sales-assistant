# Copy this file to .env and change what you need. The app reads .env at startup.

# Which model answers: transformers (your GPU), openai (Ollama, vLLM, Groq...) or mock (no model)
LLM_BACKEND=transformers
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# For LLM_BACKEND=openai. Ollama on your laptop:  ollama pull qwen2.5:7b-instruct
# and start it with OLLAMA_CONTEXT_LENGTH=8192 so long prompts are not cut.
OPENAI_BASE_URL=http://127.0.0.1:11434/v1
OPENAI_MODEL=qwen2.5:7b-instruct
OPENAI_API_KEY=
LLM_TIMEOUT_SECONDS=180

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
LEADS_PATH=data/Nova_Digital_Leads.xlsx
PDF_PATH=data/Nova_Digital_Sales_Playbook.pdf

# 1 = run the web app without any model (for UI work)
MOCK_LLM=0

# The CRM sheet is a snapshot from 2026-10-22. "At risk" is counted from this date.
# Use AS_OF_DATE=today with live CRM data.
AS_OF_DATE=2026-10-22

SESSION_TTL_MINUTES=120
MAX_SESSIONS=500
MAX_MESSAGE_CHARS=1000
